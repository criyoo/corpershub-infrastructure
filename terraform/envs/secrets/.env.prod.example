# Local Terraform secrets for the prod workspace.
# Copy to .env.prod and replace the placeholder values before running `make plan`.
# EMAIL_HOST_PASSWORD must be the Hostinger mailbox password for `info@corpershub.ng`.
# TAILSCALE_AUTHKEY should be a preauthorized auth key. Do not pair it with advertised tags
# unless your tailnet ACL explicitly allows those tags for the key.

TF_VAR_api_secure_parameters='{
  "DJANGO_SECRET_KEY": "replace-me",
  "DJANGO_SUPERUSER_PASSWORD": "replace-me",
  "FIELD_ENCRYPTION_KEY": "replace-me",
  "EMAIL_HOST_PASSWORD": "replace-me",
  "TAILSCALE_AUTHKEY": "REPLACE-WITH-PREAUTHORIZED-KEY",
  "DIKRIPT_API_BASE_URL": "replace-me",
  "DIKRIPT_PUBLIC_KEY": "replace-me",
  "DIKRIPT_SECRET_KEY": "replace-me",
  "DIKRIPT_TIMEOUT_SECONDS": "replace-me",
  "PREMBLY_API_SECRET_KEY": "replace-me",
  "PREMBLY_API_PUBLIC_KEY": "replace-me",
  "FLUTTERWAVE_PUBLIC_KEY": "replace-me",
  "FLUTTERWAVE_SECRET_KEY": "replace-me",
  "FLUTTERWAVE_CLIENT_ID": "replace-me",
  "FLUTTERWAVE_CLIENT_SECRET": "replace-me",
  "FLUTTERWAVE_ENCRYPTION_KEY": "replace-me",
  "FLUTTERWAVE_WEBHOOK_SECRET_HASH": "replace-me"
}'
